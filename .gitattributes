# Sealed-marker fixtures are fingerprinted by sha256 over their exact bytes.
# Keep git from rewriting line endings on checkout (autocrlf would break the digests).
exec-harness/fixtures/*.sealed.json -text
exec-harness/fixtures/*.sha256 -text
evidence/commitments/*.sha256 -text
# Evidence hashes refer to the exact bytes published as Git blobs.
evidence/**/metrics.json -text
evidence/**/manifest.json -text
evidence/**/harness.jsonl -text
